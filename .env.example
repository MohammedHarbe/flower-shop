# Choose one local database. Existing .env files using flower_shop.dp stay valid.
DATABASE_URL=sqlite:///./flower_shop.db
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/toneflowers
# URL-encode special characters in passwords. Never commit the real URL/password.
# Automated PostgreSQL tests require TEST_DATABASE_URL in the shell (not here):
# postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/toneflowers_test
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate a long random value before using admin API routes.
ADMIN_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SHOP_NOTIFICATION_EMAILS=toneflowerss@gmail.com,midoharpi02@gmail.com
