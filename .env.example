# Choose one local database. Existing .env files using flower_shop.dp stay valid.
APP_ENV=development
DATABASE_URL=sqlite:///./flower_shop.db
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/toneflowers
# URL-encode special characters in passwords. Never commit the real URL/password.
# Automated PostgreSQL tests require TEST_DATABASE_URL in the shell (not here):
# postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/toneflowers_test
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
WHATSAPP_NUMBER=
VODAFONE_CASH_NUMBER=
# Staging/production: APP_ENV=staging or production, PostgreSQL and exact HTTPS origins.
# DATABASE_URL=postgresql+psycopg://toneflowers_app:URL_ENCODED_PASSWORD@DB_HOST:5432/toneflowers
# CORS_ORIGINS=https://toneflowers.example,https://www.toneflowers.example
# Generate a random value with at least 32 characters before using admin API routes.
ADMIN_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SHOP_NOTIFICATION_EMAILS=owner-one@example.com,owner-two@example.com
